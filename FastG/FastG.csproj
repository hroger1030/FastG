<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Title>FastG (Fast Geometry) Library</Title>
    <AssemblyVersion>3.0.1</AssemblyVersion>
    <FileVersion>3.0.1</FileVersion>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>3.0.1</Version>
    <Description>FastG ("Fast Geometry"): a small, fast geometry library for games and real-time applications: points, vectors, rectangles, circles, ellipses, triangles, polygons, rays, planes, spheres, cubes, AABBs, capsules, cylinders, and N-dimensional vectors.

Every shape is an immutable value type (readonly struct), so building one per frame or running thousands of intersection tests in a tight loop allocates nothing and adds no GC pressure. Shapes carry value equality (==, Equals, GetHashCode) and work correctly as dictionary keys. Includes intersection and containment tests, distances, area / volume / perimeter, and arithmetic operators.

Coordinates are stored as float — the library trades precision for speed and is not intended for CAD or scientific computing. AARectangle, Cube, and AABB are axis-aligned (no rotation).

MIT licensed.</Description>
    <Company>GamrTable</Company>
    <Copyright>Copyright 2017, Roger Hill</Copyright>
    <PackageProjectUrl>https://github.com/hroger1030/FastG</PackageProjectUrl>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageTags>geometry;games;performance;dotnet</PackageTags>
    <PackageReleaseNotes>Refactor and rebrand of Geometry library - 
tuned for speed and perf as #1 goal.</PackageReleaseNotes>
    <PackAsTool>False</PackAsTool>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <Authors>Roger_Hill</Authors> 
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
